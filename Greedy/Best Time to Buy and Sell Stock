class Solution {
    public int maxProfit(int[] prices) {

        int min_price = Integer.MAX_VALUE;

        int max_profit = 0;

        for(int i=0; i<prices.length; i++){

            min_price = Math.min(prices[i],min_price); //find the min price so far

            max_profit = Math.max(max_profit, prices[i] - min_price ); //max profit so far and today's selling price (profit today)
        }

        return max_profit;
        
    }
}
