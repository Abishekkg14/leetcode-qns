class Solution {
    public void merge(int[] nums1, int m, int[] nums2, int n) {

        int i = m-1; int j = n-1; int k = m+n-1;

        while(j>=0){
            if(i>=0 && nums1[i]>nums2[j]){
                nums1[k] = nums1[i]; i--;
            }else{nums1[k] = nums2[j]; j--;}
            k--;
        }
        
    }
}

//Compare i & j → put the larger at k → move the pointer you used → k-- → repeat

/*

i → end of nums1
j → end of nums2
k → end of result

take larger
→ move the pointer you used
→ move k
→ repeat

*/
