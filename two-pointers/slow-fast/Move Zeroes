class Solution {
    public void moveZeroes(int[] nums) {
        int slow = -1;

        for(int fast = 0; fast < nums.length; fast++){
            if(nums[fast]!=0){
                slow++;
                nums[slow] = nums[fast];
            }
        }

        for(int i= slow+1 ; i<nums.length; i++){ nums[i] = 0; }

    }
}
