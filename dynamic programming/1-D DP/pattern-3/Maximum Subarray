class Solution {
    
    int best(int[] nums, int i, int[] memo){

        if(i==0){
            memo[0] = nums[0];
            return memo[0];
        }

        if(memo[i]!=-1){return memo[i];}

        int take = nums[i];
        int extend = nums[i] + best(nums,i-1,memo);

        memo[i] = Math.max(take,extend);
        return memo[i];
    }
    
    
    public int maxSubArray(int[] nums) {
        int n = nums.length; 

        int[] memo = new int[n]; Arrays.fill(memo,-1);

        int ans = best(nums,n-1,memo); 
        
        int max = Integer.MIN_VALUE ;
        for(int x: memo){
            max = Math.max(x,max);
        }

        return max;
    }
}
