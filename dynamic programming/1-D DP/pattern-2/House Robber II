//bottom-up implementation (naukri code ninja 360)

import java.util.* ;
import java.io.*; 
public class Solution {

	public static long rob(int[] houses, int start, int end){
		int n = end - start + 1;
		long[] dp = new long[n+2];

		for(int i = n-1; i>=0; i--){

			int houseindex = start + i;

			long take = houses[houseindex] + dp[i+2];

			long skip = dp[i+1];

			dp[i] = Math.max(take,skip);

		}

		return dp[0];

	}


	public static long houseRobber(int[] valueInHouse) {
		int n = valueInHouse.length;
		if(n==0){return 0;}
		if(n==1){return valueInHouse[0];}

		long case1 = rob(valueInHouse,1,n-1);
		long case2 = rob(valueInHouse,0,n-2);

		return Math.max(case1,case2);
			
	}	
}
